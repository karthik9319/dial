{
  "name": "dial",
  "version": "1.0.0",
  "description": "Dial — a gamified Pomodoro focus console (Electron wrapper)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.dial.focusconsole",
    "productName": "Dial",
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../styles.css",
      "../logic.js",
      "../app.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  }
}
